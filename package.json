{
  "name": "@webship.co/workspace-screens",
  "version": "1.0.8",
  "description": "Screens and terminals for Webship Workspace: run any cmd-*.sh in a named, detached screen session with a log, from the dashboard and from the terminal; find every run again after a restart; attach from your own terminal; open a shell in a project folder or inside its container, on whichever container runtime the project uses. Every part is a switch in its settings file.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-screens.git"
  },
  "files": [
    "dist/src",
    "commands",
    "config",
    "css",
    "features",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "screens",
    "label": "Screens and terminals",
    "settingsFile": "plugin.screens.settings.yml",
    "settingsTemplate": "config/plugin.screens.settings.yml",
    "labels": "config/settings.labels.yml",
    "commands": {
      "types": [
        "sites",
        "code"
      ],
      "files": [
        "commands/cmd-tools-screens.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-screens.sh"
      ],
      "args": [
        "scripts/args/arg-screens.sh"
      ],
      "machine": [
        "config/screenrc"
      ],
      "hostInstall": "scripts/host-install.sh"
    },
    "css": [
      "css/screens.css"
    ],
    "features": [
      "features/screens.feature"
    ],
    "needs": {
      "commands": [
        {
          "command": "container:screen",
          "hint": "It is in the dashboard image; without the dashboard container: sudo apt install -y screen"
        }
      ]
    },
    "suggests": {
      "plugins": [
        [
          "dev",
          "test",
          "sandboxes",
          "demos",
          "projects",
          "products"
        ],
        "docker",
        "lando",
        "docksal",
        "podman",
        "kubernetes"
      ],
      "commands": [
        {
          "command": "screen",
          "hint": "To attach from the machine itself: sudo apt install -y screen"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.7",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
